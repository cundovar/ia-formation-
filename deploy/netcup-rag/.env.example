# Domaine HTTPS du service RAG. L'API est protégée par RAG_SERVICE_TOKEN.
RAG_SERVICE_HOST=rag.formation-ia.example.org

# Générer avec : openssl rand -hex 32
# Ne jamais versionner la valeur réelle.
RAG_SERVICE_TOKEN=a-remplacer-par-un-jeton-aleatoire-de-64-caracteres

# La clé protège Qdrant du réseau Docker. Générer une autre valeur aléatoire.
QDRANT_API_KEY=a-remplacer-par-une-cle-qdrant-differente

# Modèle multilingue exécuté localement.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
