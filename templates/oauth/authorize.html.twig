{% extends 'base.html.twig' %}

{% block title %}Autoriser un connecteur{% endblock %}

{% block body %}
<main class="oauth-page">
    <div class="oauth-card">
        {% if error is defined and error %}
            <h1>Connexion impossible</h1>
            <p class="oauth-error" role="alert">{{ error }}</p>
            <p>Retournez dans Claude ou ChatGPT et ajoutez de nouveau le connecteur.</p>
        {% else %}
            <h1>Autoriser « {{ client.name }} »</h1>
            <p>
                <strong>{{ client.name }}</strong> demande à préparer des cours pour ce site,
                au nom de <strong>{{ app.user.userIdentifier }}</strong>.
            </p>
            <p>Il pourra :</p>
            <ul>
                <li>lire le catalogue, les règles de la formation à l'IA et les captures ;</li>
                <li>créer et modifier des <strong>brouillons</strong>, et relire ceux d'un autre connecteur ;</li>
                <li>soumettre un brouillon à votre relecture dans le back-office.</li>
            </ul>
            <p>Il ne pourra <strong>jamais publier</strong> un cours ni modifier un cours publié.</p>
            <p class="oauth-note">Retour vers : <code>{{ redirect_host }}</code>. Vous pourrez couper cet accès à tout moment (commande <code>app:connecteurs revoke</code> sur le serveur).</p>

            <form method="post" action="{{ path('oauth_authorize_decision') }}" class="oauth-actions">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('oauth_authorize') }}">
                {% for name, value in params %}
                    <input type="hidden" name="{{ name }}" value="{{ value }}">
                {% endfor %}
                <button type="submit" name="decision" value="approve" class="oauth-approve">Autoriser</button>
                <button type="submit" name="decision" value="deny" class="oauth-deny">Refuser</button>
            </form>
        {% endif %}
    </div>
</main>
{% endblock %}

{% block stylesheets %}
<style>
.oauth-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 50%, #fefce8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1f2937;
}
.oauth-card {
    max-width: 480px;
    width: 100%;
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    padding: 2rem;
    border: 1px solid #f3f4f6;
    line-height: 1.5;
}
.oauth-card h1 { font-size: 1.5rem; margin: 0 0 1rem; color: #1e3a8a; }
.oauth-card ul { padding-left: 1.25rem; }
.oauth-note { font-size: 0.875rem; color: #4b5563; }
.oauth-error { color: #b91c1c; font-weight: 600; }
.oauth-actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; }
.oauth-actions button {
    flex: 1;
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
}
.oauth-approve { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border: none; }
.oauth-deny { background: white; color: #1f2937; border: 1px solid #e5e7eb; }
.oauth-actions button:focus-visible { outline: 3px solid #fbbf24; outline-offset: 2px; }
</style>
{% endblock %}
