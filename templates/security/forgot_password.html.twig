{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>Mot de passe oublié</h1>
            <p class="subtitle">Indiquez l'adresse e-mail de votre compte : nous vous envoyons un lien pour choisir un nouveau mot de passe.</p>
        </div>

        {% if error %}
            <div class="alert alert-danger" role="alert"><span>{{ error }}</span></div>
        {% endif %}

        {% if sent %}
            <div class="alert alert-info" role="status">
                <span>Si un compte existe avec cette adresse, un e-mail vient de partir. Le lien est valable une heure. Pensez à regarder dans les courriers indésirables.</span>
            </div>
        {% else %}
            <form method="post" class="login-form" novalidate>
                <div class="form-group">
                    <label for="inputEmail">Adresse e-mail</label>
                    <input type="email" id="inputEmail" name="email" autocomplete="email" placeholder="vous@exemple.fr" required autofocus>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                <button type="submit" class="btn-login">Recevoir le lien</button>
            </form>
        {% endif %}

        <div class="register-link">
            <p><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ include('security/_auth_styles.html.twig') }}
{% endblock %}
