{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>Nouveau mot de passe</h1>
        </div>

        {% if state == 'invalid' %}
            <div class="alert alert-danger" role="alert">
                <span>Ce lien ne fonctionne plus : il a déjà servi ou il a plus d'une heure. Vous pouvez en demander un autre.</span>
            </div>
            <div class="register-link">
                <p><a href="{{ path('app_forgot_password') }}">Demander un nouveau lien</a></p>
            </div>
        {% elseif state == 'done' %}
            <div class="alert alert-info" role="status">
                <span>Votre mot de passe a été changé. Vous pouvez vous connecter.</span>
            </div>
            <div class="register-link">
                <p><a href="{{ path('app_login') }}">Se connecter</a></p>
            </div>
        {% else %}
            {% if error %}
                <div class="alert alert-danger" role="alert"><span>{{ error }}</span></div>
            {% endif %}
            <form method="post" class="login-form" novalidate>
                <div class="form-group">
                    <label for="inputPassword">Nouveau mot de passe (8 caractères au moins)</label>
                    <input type="password" id="inputPassword" name="password" autocomplete="new-password" required autofocus>
                </div>
                <div class="form-group">
                    <label for="inputPasswordConfirm">Nouveau mot de passe, une deuxième fois</label>
                    <input type="password" id="inputPasswordConfirm" name="password_confirm" autocomplete="new-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
                <button type="submit" class="btn-login">Enregistrer</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ include('security/_auth_styles.html.twig') }}
{% endblock %}
